{
  "name": "cifra",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:format": "turbo lint:format",
    "format": "prettier --write . && pnpm --filter @cifra/api format",
    "format:check": "prettier --check . && pnpm --filter @cifra/api format:check",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage --filter=@cifra/api",
    "zero-comments": "uv run --no-project --python 3.11 python scripts/check_comments.py",
    "zero-comments:test": "uv run --no-project --python 3.11 python -m unittest scripts.test_check_comments",
    "security:secrets:stage": "gitleaks git --staged --config .gitleaks.toml --redact --no-banner",
    "security:secrets:history": "uv run --no-project --python 3.11 python scripts/scan_history_secrets.py",
    "security:secrets:files": "uv run --no-project --python 3.11 python scripts/scan_tracked_secrets.py",
    "security:secrets": "pnpm run security:secrets:files && pnpm run security:secrets:history",
    "security:gitleaks": "pnpm run security:secrets:history",
    "security:dependencies": "pnpm audit --audit-level high && pnpm --filter @cifra/api security:dependencies",
    "security:trivy": "trivy fs --scanners vuln,misconfig,secret --severity HIGH,CRITICAL --exit-code 1 --skip-dirs node_modules --skip-dirs apps/api/.venv --skip-dirs imports .",
    "security": "pnpm run security:secrets:history && pnpm run security:secrets:stage && pnpm run security:dependencies",
    "expo:check": "pnpm --filter @cifra/mobile exec expo install --check",
    "expo:doctor": "pnpm --filter @cifra/mobile exec npx expo-doctor@1.20.4",
    "quality": "pnpm lint && pnpm lint:format && pnpm format:check && pnpm zero-comments && pnpm zero-comments:test && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build",
    "verify": "pnpm quality && pnpm run security:secrets:files && pnpm run security:secrets:history && pnpm expo:check && pnpm expo:doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@secretlint/secretlint-rule-pattern": "13.0.5",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "prettier": "3.9.6",
    "secretlint": "13.0.5",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
